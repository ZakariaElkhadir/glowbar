#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"

OS=$(uname -s)

case "$OS" in
  Linux)
    # Arch Linux
    if command -v makepkg >/dev/null 2>&1; then
        cd "$ROOT/pkgbuild"
        exec makepkg -fsi "$@"
    fi
    # Generic Linux: install to /usr/local
    PREFIX="${PREFIX:-/usr/local}"
    install -Dm755 "$ROOT/build/glowbar" "$PREFIX/bin/glowbar"
    install -Dm644 "$ROOT/LICENSE" "$PREFIX/share/licenses/glowbar/LICENSE"
    install -Dm644 -t "$PREFIX/share/licenses/glowbar/fonts" "$ROOT"/src/fonts/OFL-*.txt
    install -Dm644 "$ROOT/pkgbuild/glowbar.svg" "$PREFIX/share/icons/hicolor/scalable/apps/glowbar.svg"
    install -Dm644 "$ROOT/pkgbuild/glowbar.desktop" "$PREFIX/share/applications/glowbar.desktop"
    echo "Installed to $PREFIX"
    ;;
  Darwin)
    APP="$ROOT/build/glowbar.app"
    DEST="${PREFIX:-/Applications}"
    if [ ! -d "$APP" ]; then
        echo "error: $APP not found. Run bin/build first." >&2
        exit 1
    fi
    cp -r "$APP" "$DEST/"
    echo "Installed $DEST/glowbar.app"
    ;;
  *)
    echo "error: unsupported OS: $OS" >&2
    exit 1
    ;;
esac
