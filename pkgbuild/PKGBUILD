pkgname=glowbar
pkgver=0.1.0
pkgrel=1
pkgdesc='Control a Bluetooth LED strip from the desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-connectivity' 'bluez')
makedepends=('gcc' 'make')
# Formerly packaged as ledstrip.
replaces=('ledstrip')
conflicts=('ledstrip')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/glowbar "$pkgdir/usr/bin/glowbar"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/fonts" src/fonts/OFL-*.txt
  install -Dm644 "$startdir/glowbar.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/glowbar.svg"
  install -Dm644 "$startdir/glowbar.desktop" "$pkgdir/usr/share/applications/glowbar.desktop"
}
