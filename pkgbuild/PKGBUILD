pkgname=ledstrip
pkgver=0.1.0
pkgrel=1
pkgdesc='Control a Bluetooth LED strip from the desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-connectivity' 'bluez')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ledstrip "$pkgdir/usr/bin/ledstrip"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ledstrip.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ledstrip.svg"
  install -Dm644 "$startdir/ledstrip.desktop" "$pkgdir/usr/share/applications/ledstrip.desktop"
}
